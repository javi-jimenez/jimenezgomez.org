#!/usr/bin/env bash
set -euo pipefail
# Pre-commit: cada artículo que entra en el commit tiene que llevar su portada.
#
# Sólo se procesan los artículos tocados en ESTE commit (antes se rehacían las
# 39 portadas en cada commit, que era lento y reescribía ficheros ajenos).
# El dibujo lo hace tools/coverart a través de tools/generate-og-image.py; si el
# artículo no tiene entrada en coverart/specs.py, se avisa y se usa la
# plantilla sobria.

cd "$(git rev-parse --show-toplevel)"

STAGED_INDEXS=$(git diff --cached --name-only --diff-filter=ACM \
  | grep -E '^content/posts/.+/index\.md$' || true)

if [ -z "$STAGED_INDEXS" ]; then
  exit 0
fi

echo "pre-commit: generando portadas de los artículos en el commit..."
for md in $STAGED_INDEXS; do
  dir=$(dirname "$md")
  echo " - $dir"
  python3 tools/generate-og-image.py "$dir" --set-frontmatter || true
  for f in og-image.svg og-image-1200x630.png og-image-600x315.png; do
    [ -f "$dir/$f" ] && git add "$dir/$f"
  done
  git add "$md"
done

echo "pre-commit: done."
exit 0
