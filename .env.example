# Example environment variables for jimenezgomez.org
# Copy this file to .env and fill values for your environment.

# Site settings
BASE_URL=https://jimenezgomez.org
HUGO_TITLE="Francisco Javier Jiménez Gómez"
GOOGLE_MEASUREMENT_ID=G-XXXXXXXXXX   # e.g. G-XXXXXXXXX (leave empty to disable analytics)

# Deployment (Drone / FTP / OVH)
FTP_SERVER=tu-servidor-ftp.ovh.net
FTP_USERNAME=tu-usuario
FTP_PASSWORD=tu-contraseña

# Optional Docker registry (if you push images)
DOCKER_REGISTRY_SERVER=
DOCKER_REGISTRY_USERNAME=
DOCKER_REGISTRY_PASSWORD=

# GitHub / automation scripts
# Set GITHUB_TOKEN as secret in CI; local .env may remain empty for tokens
GITHUB_REPOSITORY=owner/repo
GITHUB_TOKEN=
REMINDER_DAYS=30

# Runtime / container
TZ=Europe/Madrid
HTTP_PORT=80

# Notes:
# - Do NOT commit real secrets to the repository. Use your CI/CD provider's secrets store.
# - Copy this file to a local `.env` and customize values as needed.
